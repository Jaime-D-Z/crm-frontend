# ═══════════════════════════════════════════════════════════
# CRM FRONTEND - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Backend API URL
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:3000

# Environment
VITE_ENV=development

# ═══════════════════════════════════════════════════════════
# PRODUCTION NOTES
# ═══════════════════════════════════════════════════════════
#
# 1. Create .env.production with your actual API URL
# 2. NEVER use http:// in production, always https://
# 3. Vite automatically uses .env.production when building
# 4. Variables MUST start with VITE_ to be exposed to client
# 5. Never store secrets here (client-side code is public)
#
# ═══════════════════════════════════════════════════════════
